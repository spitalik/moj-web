<?xml version="1.0" encoding="utf-8"?>
<!-- Skóre, jazyk a počty hier zostávajú len v telefóne: bez zálohy do Google a bez prenosu na iné zariadenie.
     Appka nemá účet ani server, nič sa neodosiela. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
