<?xml version="1.0" encoding="utf-8"?>
<!-- Zdravotné údaje (merania tlaku) zostávajú len v telefóne: bez zálohy do Google a bez prenosu na iné zariadenie.
     Prenos dát medzi telefónmi: Nastavenia → Stiahnuť zálohu (JSON) a Obnoviť. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
